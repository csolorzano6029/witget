<Window x:Class="HardwareWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hardware Monitor Widget"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Deactivated="Window_Deactivated"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Closed="Window_Closed">

    <Window.Resources>
        <Style x:Key="DiscreetGearButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#DCE3EC"/>
            <Setter Property="Opacity" Value="0.42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1.0"/>
                                <Setter TargetName="Bd" Property="Background" Value="#28FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="1.0"/>
                                <Setter TargetName="Bd" Property="Background" Value="#3EFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu x:Name="WidgetContextMenu" MinWidth="230">
            <!-- Check / Switch de Modo Minimalista -->
            <MenuItem x:Name="MinimalistMenuItem"
                      Header="✨ Modo Minimalista (Solo Temp)"
                      IsCheckable="True"
                      IsChecked="False"
                      StaysOpenOnClick="True"
                      Click="MinimalistMenuItem_Click"/>
            <MenuItem Header="👁️ Mostrar indicadores">
                <MenuItem x:Name="ShowCpuMenuItem"
                          Header="🔥 CPU"
                          IsCheckable="True"
                          IsChecked="True"
                          StaysOpenOnClick="True"
                          Click="ShowCpuMenuItem_Click"/>
                <MenuItem x:Name="ShowGpuMenuItem"
                          Header="🟩 GPU"
                          IsCheckable="True"
                          IsChecked="True"
                          StaysOpenOnClick="True"
                          Click="ShowGpuMenuItem_Click"/>
                <MenuItem x:Name="ShowRamMenuItem"
                          Header="🧠 RAM"
                          IsCheckable="True"
                          IsChecked="True"
                          StaysOpenOnClick="True"
                          Click="ShowRamMenuItem_Click"/>
                <MenuItem x:Name="ShowFpsMenuItem"
                          Header="🎮 FPS"
                          IsCheckable="True"
                          IsChecked="True"
                          StaysOpenOnClick="True"
                          Click="ShowFpsMenuItem_Click"/>
                <MenuItem x:Name="ShowPingMenuItem"
                          Header="📡 Ping (Juego)"
                          IsCheckable="True"
                          IsChecked="True"
                          StaysOpenOnClick="True"
                          Click="ShowPingMenuItem_Click"/>
            </MenuItem>

            <!-- Estilo de Fondo -->
            <MenuItem Header="🎨 Fondo">
                <MenuItem x:Name="IndividualBgMenuItem"
                          Header="🗂️ Tarjetas individuales"
                          IsCheckable="True"
                          IsChecked="True"
                          StaysOpenOnClick="True"
                          Click="IndividualBg_Click"/>
                <MenuItem x:Name="UnifiedBgMenuItem"
                          Header="🧱 Bloque único"
                          IsCheckable="True"
                          IsChecked="False"
                          StaysOpenOnClick="True"
                          Click="UnifiedBg_Click"/>
                <MenuItem x:Name="NoBgMenuItem"
                          Header="🫥 Sin fondo (Solo texto)"
                          IsCheckable="True"
                          IsChecked="False"
                          StaysOpenOnClick="True"
                          Click="NoBg_Click"/>
            </MenuItem>

            <Separator/>

            <!-- Orientación: Vertical u Horizontal -->
            <MenuItem Header="📐 Disposición">
                <MenuItem x:Name="VerticalLayoutMenuItem"
                          Header="↕️ Vertical (Arriba / Abajo)"
                          IsCheckable="True"
                          IsChecked="True"
                          Click="VerticalLayout_Click"/>
                <MenuItem x:Name="HorizontalLayoutMenuItem"
                          Header="↔️ Horizontal (Lado a lado)"
                          IsCheckable="True"
                          IsChecked="False"
                          Click="HorizontalLayout_Click"/>
            </MenuItem>

            <Separator/>

            <!-- Slider de Opacidad -->
            <MenuItem StaysOpenOnClick="True">
                <MenuItem.Header>
                    <StackPanel Width="190" Margin="0,2">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="🔆 Opacidad" FontWeight="SemiBold"/>
                            <TextBlock x:Name="OpacityValueText" Text="90%" HorizontalAlignment="Right" Foreground="#666"/>
                        </Grid>
                        <Slider x:Name="OpacitySlider"
                                Minimum="0.15"
                                Maximum="1.0"
                                Value="0.90"
                                TickFrequency="0.05"
                                ValueChanged="OpacitySlider_ValueChanged"/>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>

            <!-- Slider de Tamaño -->
            <MenuItem StaysOpenOnClick="True">
                <MenuItem.Header>
                    <StackPanel Width="190" Margin="0,2">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="🔍 Tamaño del Widget" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ScaleValueText" Text="100%" HorizontalAlignment="Right" Foreground="#666"/>
                        </Grid>
                        <Slider x:Name="ScaleSlider"
                                Minimum="0.50"
                                Maximum="2.0"
                                Value="1.0"
                                TickFrequency="0.05"
                                ValueChanged="ScaleSlider_ValueChanged"/>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>

            <!-- Slider de Separación entre indicadores -->
            <MenuItem StaysOpenOnClick="True">
                <MenuItem.Header>
                    <StackPanel Width="190" Margin="0,2">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="↔️ Separación" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SpacingValueText" Text="8 px" HorizontalAlignment="Right" Foreground="#666"/>
                        </Grid>
                        <Slider x:Name="SpacingSlider"
                                Minimum="0"
                                Maximum="32"
                                Value="8"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                ValueChanged="SpacingSlider_ValueChanged"/>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>

            <Separator/>

            <MenuItem x:Name="TopmostMenuItem"
                      Header="📌 Siempre encima (Topmost)"
                      IsCheckable="True"
                      IsChecked="True"
                      Click="TopmostMenuItem_Click"/>
            <MenuItem x:Name="LockPositionMenuItem"
                      Header="🔒 Bloquear posición"
                      IsCheckable="True"
                      IsChecked="False"
                      Click="LockPositionMenuItem_Click"/>
            <MenuItem x:Name="ClickThroughMenuItem"
                      Header="🎮 Ignorar clics siempre (Alt para menú)"
                      IsCheckable="True"
                      IsChecked="False"
                      Click="ClickThroughMenuItem_Click"/>
            <MenuItem x:Name="StartWithWindowsMenuItem"
                      Header="🚀 Iniciar con Windows"
                      IsCheckable="True"
                      IsChecked="True"
                      Click="StartWithWindowsMenuItem_Click"/>
            <MenuItem x:Name="AdminMenuItem"
                      Header="🛡️ Reiniciar como Administrador"
                      Click="RestartAsAdmin_Click"/>

            <Separator/>

            <MenuItem Header="👁️ Ocultar / Mostrar (Ctrl+Shift+H)" Click="ToggleVisibilityMenuItem_Click"/>
            <MenuItem Header="❌ Cerrar Widget" Click="CloseMenuItem_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <!-- Contenedor principal sin borde ni fondo exterior -->
    <StackPanel x:Name="RootContainer" Margin="4" Background="Transparent">
        <StackPanel.LayoutTransform>
            <ScaleTransform x:Name="WidgetScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
        </StackPanel.LayoutTransform>

        <!-- Contenedor único opcional que agrupa todos los indicadores -->
        <Border x:Name="UnifiedContainer"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="12"
                Padding="0">
            <!-- Panel que alterna entre Vertical y Horizontal -->
            <StackPanel x:Name="CardsPanel" Orientation="Vertical">

            <!-- Cajita 1: CPU -->
            <Border x:Name="CpuCard"
                    Width="215"
                    Background="#EE141720"
                    BorderBrush="#38FFFFFF"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock x:Name="CpuTitleText" Text="CPU" Foreground="#FF7B54" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="CpuNameText"
                                   Text="Detectando..."
                                   Foreground="#99AAB8"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="115"/>
                        <TextBlock x:Name="CpuLoadText"
                                   Text="Uso: --%"
                                   Foreground="#CED6E0"
                                   FontSize="11"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <TextBlock x:Name="CpuTempText"
                               Grid.Column="1"
                               Text="--°C"
                               MinWidth="60"
                               TextAlignment="Right"
                               Foreground="#00E676"
                               FontSize="24"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Cajita 2: GPU -->
            <Border x:Name="GpuCard"
                    Width="215"
                    Margin="0,8,0,0"
                    Background="#EE141720"
                    BorderBrush="#38FFFFFF"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock x:Name="GpuTitleText" Text="GPU" Foreground="#76B900" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="GpuNameText"
                                   Text="Detectando..."
                                   Foreground="#99AAB8"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="115"/>
                        <TextBlock x:Name="GpuLoadText"
                                   Text="Uso: --%"
                                   Foreground="#CED6E0"
                                   FontSize="11"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <TextBlock x:Name="GpuTempText"
                               Grid.Column="1"
                               Text="--°C"
                               MinWidth="60"
                               TextAlignment="Right"
                               Foreground="#00E676"
                               FontSize="24"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Cajita 3: RAM -->
            <Border x:Name="RamCard"
                    Width="215"
                    Margin="0,8,0,0"
                    Background="#EE141720"
                    BorderBrush="#38FFFFFF"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock x:Name="RamTitleText" Text="RAM" Foreground="#CE93D8" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="RamUsageDetailText"
                                   Text="-- / -- GB"
                                   Foreground="#99AAB8"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="115"/>
                        <TextBlock x:Name="RamPercentText"
                                   Text="Uso: --%"
                                   Foreground="#CED6E0"
                                   FontSize="11"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <TextBlock x:Name="RamMainText"
                               Grid.Column="1"
                               Text="--%"
                               Foreground="#00E676"
                               FontSize="24"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Cajita 4: FPS -->
            <Border x:Name="FpsCard"
                    Width="215"
                    Margin="0,8,0,0"
                    Background="#EE141720"
                    BorderBrush="#38FFFFFF"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock x:Name="FpsTitleText" Text="FPS (VENTANA)" Foreground="#4FC3F7" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="FpsAppText"
                                   Text="En espera"
                                   Foreground="#99AAB8"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="115"/>
                        <TextBlock x:Name="FpsFrameTimeText"
                                   Text="Frame: -- ms"
                                   Foreground="#CED6E0"
                                   FontSize="11"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <TextBlock x:Name="FpsValueText"
                               Grid.Column="1"
                               Text="--"
                               Width="52"
                               TextAlignment="Right"
                               Foreground="#96A0AF"
                               FontSize="24"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Cajita 5: PING (solo visible cuando hay un juego ejecutándose) -->
            <Border x:Name="PingCard"
                    Visibility="Collapsed"
                    Width="215"
                    Margin="0,8,0,0"
                    Background="#EE141720"
                    BorderBrush="#38FFFFFF"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock x:Name="PingTitleText" Text="PING (JUEGO)" Foreground="#26C6DA" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="PingGameText"
                                   Text="Sin juego"
                                   Foreground="#99AAB8"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="115"/>
                        <TextBlock x:Name="PingServerText"
                                   Text="Servidor: --"
                                   Foreground="#CED6E0"
                                   FontSize="11"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <TextBlock x:Name="PingValueText"
                               Grid.Column="1"
                               Text="-- ms"
                               MinWidth="74"
                               TextAlignment="Right"
                               Foreground="#96A0AF"
                               FontSize="24"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Botón discreto de configuración (funciona incluso con Ignorar clics activo) -->
            <Button x:Name="SettingsButton"
                    Style="{StaticResource DiscreetGearButton}"
                    Width="24"
                    Height="24"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="SettingsButton_Click"
                    ToolTip="Configuración">
                <TextBlock Text="⚙" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Button>
            </StackPanel>
        </Border>

        <!-- Botón de aviso si falta permiso de Administrador o driver PawnIO -->
        <Button x:Name="AdminWarningButton"
                Visibility="Collapsed"
                Margin="0,6,0,0"
                Padding="8,4"
                Background="#D92A2010"
                BorderBrush="#88FF9800"
                Foreground="#FFD54F"
                FontSize="10"
                Cursor="Hand"
                Click="ActionWarningButton_Click"
                Content="🛡️ Clic para activar temp. CPU (Admin)"/>
    </StackPanel>
</Window>
