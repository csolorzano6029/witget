<Window x:Class="SystemPerformanceWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rendimiento del Sistema"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="False"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Deactivated="Window_Deactivated"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Closed="Window_Closed">

    <Window.Resources>
        <Style x:Key="IconGhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#D8E0EA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#36FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionCardButton" TargetType="Button">
            <Setter Property="Background" Value="#24FFFFFF"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#EEF3F8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#36FFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#42FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#48FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu x:Name="WidgetContextMenu" MinWidth="235">
            <MenuItem x:Name="MinimalistMenuItem"
                      Header="✨ Vista minimalista"
                      IsCheckable="True"
                      IsChecked="False"
                      StaysOpenOnClick="True"
                      Click="MinimalistMenuItem_Click"/>
            <MenuItem Header="📐 Orientación minimalista">
                <MenuItem x:Name="MiniHorizontalMenuItem"
                          Header="↔️ Horizontal"
                          IsCheckable="True"
                          IsChecked="True"
                          StaysOpenOnClick="True"
                          Click="MiniHorizontal_Click"/>
                <MenuItem x:Name="MiniVerticalMenuItem"
                          Header="↕️ Vertical"
                          IsCheckable="True"
                          IsChecked="False"
                          StaysOpenOnClick="True"
                          Click="MiniVertical_Click"/>
            </MenuItem>
            <MenuItem Header="👁️ Mostrar indicadores">
                <MenuItem x:Name="ShowCpuMenuItem"
                          Header="🔥 CPU"
                          IsCheckable="True"
                          IsChecked="True"
                          StaysOpenOnClick="True"
                          Click="VisibleSectionsMenuItem_Click"/>
                <MenuItem x:Name="ShowGpuMenuItem"
                          Header="🟩 GPU"
                          IsCheckable="True"
                          IsChecked="True"
                          StaysOpenOnClick="True"
                          Click="VisibleSectionsMenuItem_Click"/>
                <MenuItem x:Name="ShowRamMenuItem"
                          Header="🧠 RAM"
                          IsCheckable="True"
                          IsChecked="True"
                          StaysOpenOnClick="True"
                          Click="VisibleSectionsMenuItem_Click"/>
                <MenuItem x:Name="ShowFpsMenuItem"
                          Header="🎮 FPS"
                          IsCheckable="True"
                          IsChecked="True"
                          StaysOpenOnClick="True"
                          Click="VisibleSectionsMenuItem_Click"/>
                <MenuItem x:Name="ShowNetworkMenuItem"
                          Header="🌐 Red / Internet"
                          IsCheckable="True"
                          IsChecked="True"
                          StaysOpenOnClick="True"
                          Click="VisibleSectionsMenuItem_Click"/>
                <Separator/>
                <MenuItem x:Name="ShowActionButtonsMenuItem"
                          Header="🔘 Botones (Ver más / Admin)"
                          IsCheckable="True"
                          IsChecked="False"
                          StaysOpenOnClick="True"
                          Click="VisibleSectionsMenuItem_Click"/>
            </MenuItem>

            <Separator/>

            <!-- Opacidad -->
            <MenuItem StaysOpenOnClick="True">
                <MenuItem.Header>
                    <StackPanel Width="195" Margin="0,2">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="🔆 Opacidad" FontWeight="SemiBold"/>
                            <TextBlock x:Name="OpacityValueText" Text="94%" HorizontalAlignment="Right" Foreground="#666"/>
                        </Grid>
                        <Slider x:Name="OpacitySlider"
                                Minimum="0.30"
                                Maximum="1.0"
                                Value="0.94"
                                TickFrequency="0.05"
                                ValueChanged="OpacitySlider_ValueChanged"/>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>

            <!-- Escala -->
            <MenuItem StaysOpenOnClick="True">
                <MenuItem.Header>
                    <StackPanel Width="195" Margin="0,2">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="🔍 Tamaño" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ScaleValueText" Text="100%" HorizontalAlignment="Right" Foreground="#666"/>
                        </Grid>
                        <Slider x:Name="ScaleSlider"
                                Minimum="0.65"
                                Maximum="1.50"
                                Value="1.0"
                                TickFrequency="0.05"
                                ValueChanged="ScaleSlider_ValueChanged"/>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>

            <!-- Ancho personalizado -->
            <MenuItem StaysOpenOnClick="True">
                <MenuItem.Header>
                    <StackPanel Width="195" Margin="0,2">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="↔️ Ancho" FontWeight="SemiBold"/>
                            <TextBlock x:Name="WidthValueText" Text="378 px" HorizontalAlignment="Right" Foreground="#666"/>
                        </Grid>
                        <Slider x:Name="WidthSlider"
                                Minimum="160"
                                Maximum="600"
                                Value="378"
                                TickFrequency="2"
                                IsSnapToTickEnabled="True"
                                ValueChanged="WidthSlider_ValueChanged"/>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>

            <Separator/>

            <MenuItem x:Name="TopmostMenuItem"
                      Header="📌 Siempre encima (Topmost)"
                      IsCheckable="True"
                      IsChecked="False"
                      Click="TopmostMenuItem_Click"/>
            <MenuItem x:Name="LockPositionMenuItem"
                      Header="🔒 Bloquear posición"
                      IsCheckable="True"
                      IsChecked="False"
                      Click="LockPositionMenuItem_Click"/>
            <MenuItem x:Name="ClickThroughMenuItem"
                      Header="🎮 Ignorar clics siempre (Alt para menú)"
                      IsCheckable="True"
                      IsChecked="False"
                      Click="ClickThroughMenuItem_Click"/>
            <MenuItem x:Name="StartWithWindowsMenuItem"
                      Header="🚀 Iniciar con Windows"
                      IsCheckable="True"
                      IsChecked="True"
                      Click="StartWithWindowsMenuItem_Click"/>
            <MenuItem x:Name="AdminMenuItem"
                      Header="🛡️ Reiniciar como Administrador"
                      Click="RestartAsAdmin_Click"/>

            <Separator/>

            <MenuItem Header="👁️ Ocultar / Mostrar (Ctrl+Shift+R)" Click="ToggleVisibilityMenuItem_Click"/>
            <MenuItem Header="📊 Abrir Administrador de tareas" Click="OpenTaskManager_Click"/>
            <MenuItem Header="❌ Cerrar Widget" Click="CloseMenuItem_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid x:Name="RootContainer" Margin="10" Background="Transparent">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="WidgetScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
        </Grid.LayoutTransform>

        <StackPanel>
            <!-- VISTA COMPLETA -->
            <Border x:Name="FullViewCard"
                    Width="378"
                    CornerRadius="14"
                    BorderBrush="#32FFFFFF"
                    BorderThickness="1"
                    Padding="14,12,14,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#EE222731" Offset="0.0"/>
                    <GradientStop Color="#EE171B23" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="5" Opacity="0.50"/>
            </Border.Effect>

            <StackPanel>
                <!-- Encabezado -->
                <Grid Margin="2,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Rendimiento del Sistema"
                               Grid.Column="0"
                               Foreground="#F4F7FB"
                               FontSize="15"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <Button x:Name="SettingsButton"
                            Grid.Column="1"
                            Style="{StaticResource IconGhostButton}"
                            Width="28"
                            Height="28"
                            Click="SettingsButton_Click"
                            ToolTip="Configuración">
                        <TextBlock Text="⚙" FontSize="16" Foreground="#DCE3EC" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </Grid>

                <!-- Bloque 1: CPU (tono naranja cálido) -->
                <Border x:Name="CpuFullCard"
                        CornerRadius="10"
                        BorderBrush="#2EFF8C52"
                        BorderThickness="1"
                        Padding="12,9,12,10"
                        Margin="0,0,0,8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#D83F261A" Offset="0.0"/>
                            <GradientStop Color="#D82B1B14" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <StackPanel>
                        <TextBlock x:Name="CpuHeaderText"
                                   Text="CPU: Detectando..."
                                   Foreground="#F2E7E1"
                                   FontSize="12.5"
                                   FontWeight="Normal"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,4"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="CpuTempText"
                                       Grid.Column="0"
                                       Text="-- °C"
                                       Foreground="#FFFFFF"
                                       FontSize="26"
                                       FontWeight="Normal"
                                       VerticalAlignment="Center"
                                       MinWidth="76"/>

                            <Canvas x:Name="CpuSparklineCanvas"
                                    Grid.Column="1"
                                    Height="30"
                                    Margin="8,2,14,0"
                                    VerticalAlignment="Center"
                                    ClipToBounds="True"/>

                            <TextBlock x:Name="CpuLoadText"
                                       Grid.Column="2"
                                       Text="--%"
                                       Foreground="#FFFFFF"
                                       FontSize="26"
                                       FontWeight="Normal"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       MinWidth="60"
                                       TextAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Bloque 2: GPU (tono verde oscuro) -->
                <Border x:Name="GpuFullCard"
                        CornerRadius="10"
                        BorderBrush="#2E5CE66D"
                        BorderThickness="1"
                        Padding="12,9,12,10"
                        Margin="0,0,0,8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#D8233A23" Offset="0.0"/>
                            <GradientStop Color="#D8192A19" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <StackPanel>
                        <TextBlock x:Name="GpuHeaderText"
                                   Text="GPU: Detectando..."
                                   Foreground="#E6F4E7"
                                   FontSize="12.5"
                                   FontWeight="Normal"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,4"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="GpuTempText"
                                       Grid.Column="0"
                                       Text="-- °C"
                                       Foreground="#FFFFFF"
                                       FontSize="26"
                                       FontWeight="Normal"
                                       VerticalAlignment="Center"
                                       MinWidth="76"/>

                            <Canvas x:Name="GpuSparklineCanvas"
                                    Grid.Column="1"
                                    Height="30"
                                    Margin="8,2,14,0"
                                    VerticalAlignment="Center"
                                    ClipToBounds="True"/>

                            <TextBlock x:Name="GpuLoadText"
                                       Grid.Column="2"
                                       Text="--%"
                                       Foreground="#FFFFFF"
                                       FontSize="26"
                                       FontWeight="Normal"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       MinWidth="60"
                                       TextAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Bloque 3: RAM (tono azul oscuro + barra de progreso + sparkline) -->
                <Border x:Name="RamFullCard"
                        CornerRadius="10"
                        BorderBrush="#2E4FC3F7"
                        BorderThickness="1"
                        Padding="12,9,12,10"
                        Margin="0,0,0,8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#D81D344E" Offset="0.0"/>
                            <GradientStop Color="#D815263A" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <StackPanel>
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="105"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="RamHeaderText"
                                           Text="RAM: Detectando..."
                                           Foreground="#F0F6FC"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="RamSubText"
                                           Text="-- GB Usados (--%)"
                                           Foreground="#B8CBE0"
                                           FontSize="11.5"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <Canvas x:Name="RamSparklineCanvas"
                                    Grid.Column="1"
                                    Height="30"
                                    VerticalAlignment="Center"
                                    ClipToBounds="True"/>
                        </Grid>

                        <!-- Barra de progreso RAM -->
                        <Grid Height="6">
                            <Border Background="#2EFFFFFF" CornerRadius="3"/>
                            <Border x:Name="RamProgressFill"
                                    HorizontalAlignment="Left"
                                    Width="0"
                                    CornerRadius="3">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#38A8FF" Offset="0.0"/>
                                        <GradientStop Color="#66D0FF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Bloque 4: FPS + Red/Internet + Botones -->
                <Border x:Name="BottomFullCard"
                        CornerRadius="10"
                        BorderBrush="#22FFFFFF"
                        BorderThickness="1"
                        Padding="12,10,12,12">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#D81B222F" Offset="0.0"/>
                            <GradientStop Color="#D8141A24" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <StackPanel>
                        <!-- Sección FPS -->
                        <Grid x:Name="FpsFullSection" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="FPS"
                                           Foreground="#DCE5F0"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="FpsValueText"
                                           Text="-- FPS"
                                           Foreground="#FFFFFF"
                                           FontSize="27"
                                           FontWeight="SemiBold"
                                           Margin="0,1,0,1"/>
                                <TextBlock x:Name="FpsAppText"
                                           Text="En espera"
                                           Foreground="#A8B7C8"
                                           FontSize="11.5"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="8,0,0,2">
                                <TextBlock x:Name="FpsMinMaxText"
                                           Text="Min: -- / Max: --"
                                           Foreground="#D2DDE9"
                                           FontSize="11.5"
                                           HorizontalAlignment="Right"/>
                                <TextBlock Text="Últimos 60 segundos"
                                           Foreground="#8C9CAE"
                                           FontSize="10"
                                           HorizontalAlignment="Right"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Sección Red/Internet -->
                        <Grid x:Name="NetFullSection" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="112"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Red/Internet"
                                           Foreground="#EDF2F8"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,2"/>
                                <TextBlock x:Name="NetDownText"
                                           Text="Descarga: 0.0 KB/s"
                                           Foreground="#C4D1E0"
                                           FontSize="11.5"/>
                                <TextBlock x:Name="NetUpText"
                                           Text="Subida: 0.0 KB/s"
                                           Foreground="#C4D1E0"
                                           FontSize="11.5"
                                           Margin="0,1,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                                <Canvas x:Name="NetSparklineCanvas"
                                        Height="28"
                                        ClipToBounds="True"/>
                                <TextBlock Text="Últimos 60 segundos"
                                           Foreground="#8C9CAE"
                                           FontSize="10"
                                           HorizontalAlignment="Right"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Panel expandible "Ver más" -->
                        <Border x:Name="DetailsPanel"
                                Visibility="Collapsed"
                                Background="#1CFFFFFF"
                                CornerRadius="8"
                                Padding="10,8"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="ExtraRamText" Text="RAM disponible: -- GB" Foreground="#C8D5E3" FontSize="11"/>
                                <TextBlock x:Name="ExtraClockText" Text="CPU / GPU: --" Foreground="#C8D5E3" FontSize="11" Margin="0,3,0,0"/>
                                <TextBlock x:Name="ExtraNetTotalText" Text="Sesión red: ↓ 0 MB  ↑ 0 MB" Foreground="#C8D5E3" FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Botones inferiores (ocultos por defecto) -->
                        <Grid x:Name="ActionButtonsGrid" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="MoreDetailsButton"
                                    Grid.Column="0"
                                    Style="{StaticResource ActionCardButton}"
                                    Content="Ver más"
                                    Click="MoreDetailsButton_Click"/>

                            <Button Grid.Column="2"
                                    Style="{StaticResource ActionCardButton}"
                                    Content="Abrir Administrador"
                                    Click="OpenTaskManager_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

            <!-- VISTA MINIMALISTA (horizontal o vertical con los colores del panel) -->
            <Border x:Name="MinimalistViewCard"
                    Visibility="Collapsed"
                    CornerRadius="12"
                    BorderBrush="#32FFFFFF"
                    BorderThickness="1"
                    Padding="10,7,8,7">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#EE222731" Offset="0.0"/>
                        <GradientStop Color="#EE171B23" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="4" Opacity="0.45"/>
                </Border.Effect>

                <StackPanel x:Name="MinimalistItemsPanel" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- CPU -->
                    <Border x:Name="MiniCpuPill" Background="#CC362117" BorderBrush="#2EFF8C52" BorderThickness="1" CornerRadius="8" Padding="9,4" Margin="0,0,6,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="CPU" Foreground="#FF8C52" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="MiniCpuTempText" Text="--°C" Width="40" TextAlignment="Right" Foreground="#FFFFFF" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="MiniCpuLoadText" Text="--%" Width="32" TextAlignment="Right" Foreground="#C9B7AD" FontSize="11.5" VerticalAlignment="Center" Margin="4,1,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- GPU -->
                    <Border x:Name="MiniGpuPill" Background="#CC1F341F" BorderBrush="#2E5CE66D" BorderThickness="1" CornerRadius="8" Padding="9,4" Margin="0,0,6,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="GPU" Foreground="#5CE66D" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="MiniGpuTempText" Text="--°C" Width="40" TextAlignment="Right" Foreground="#FFFFFF" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="MiniGpuLoadText" Text="--%" Width="32" TextAlignment="Right" Foreground="#B3CCB5" FontSize="11.5" VerticalAlignment="Center" Margin="4,1,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- RAM -->
                    <Border x:Name="MiniRamPill" Background="#CC1B2E46" BorderBrush="#2E4FC3F7" BorderThickness="1" CornerRadius="8" Padding="9,4" Margin="0,0,6,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="RAM" Foreground="#58B8FF" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" x:Name="MiniRamText" Text="--/--G" MinWidth="56" TextAlignment="Right" Foreground="#FFFFFF" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- FPS -->
                    <Border x:Name="MiniFpsPill" Background="#CC1B222F" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="8" Padding="9,4" Margin="0,0,6,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="FPS" Foreground="#B8CAE0" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" x:Name="MiniFpsText" Text="--" Width="32" TextAlignment="Right" Foreground="#FFFFFF" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- RED -->
                    <Border x:Name="MiniNetPill" Background="#CC1B222F" BorderBrush="#2EE5A95C" BorderThickness="1" CornerRadius="8" Padding="9,4" Margin="0,0,4,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="↓" Foreground="#E5A95C" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Grid.Column="1" x:Name="MiniNetText" Text="0 KB/s" Width="70" TextAlignment="Right" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Botón configuración -->
                    <Button x:Name="MiniSettingsButton"
                            Style="{StaticResource IconGhostButton}"
                            Width="26"
                            Height="26"
                            Click="SettingsButton_Click"
                            ToolTip="Configuración">
                        <TextBlock Text="⚙" FontSize="14" Foreground="#DCE3EC" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Botón de aviso solo si falta Admin o PawnIO -->
            <Button x:Name="ActionWarningButton"
                    Visibility="Collapsed"
                    Margin="0,8,0,0"
                    Padding="8,5"
                    Background="#D92A2010"
                    BorderBrush="#88FF9800"
                    BorderThickness="1"
                    Foreground="#FFD54F"
                    FontSize="11"
                    Cursor="Hand"
                    Click="ActionWarningButton_Click"
                    Content="🛡️ Clic para activar temp. CPU y FPS (Admin)"/>
        </StackPanel>
    </Grid>
</Window>
